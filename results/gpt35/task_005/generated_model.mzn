int: WIDTH = 10; int: HEIGHT = 10; int: DEPTH = 10; set of int: ITEMS = 1..5; array[ITEMS, 1..3] of int: item_dimensions = array1d(ITEMS, [(2,2,2), (3,3,2), (4,2,3), (1,1,1), (2,3,2)]); array[ITEMS, 1..3] of var 0..WIDTH: item_x; array[ITEMS, 1..3] of var 0..HEIGHT: item_y; array[ITEMS, 1..3] of var 0..DEPTH: item_z; constraint forall(i in ITEMS)(item_x[i,1] + item_dimensions[i,1] <= WIDTH /\n                               item_y[i,2] + item_dimensions[i,2] <= HEIGHT /\n                               item_z[i,3] + item_dimensions[i,3] <= DEPTH); constraint forall(i, j in ITEMS where i < j)(item_x[i,1] + item_dimensions[i,1] <= item_x[j,1] \/\n                                           item_x[j,1] + item_dimensions[j,1] <= item_x[i,1] \/\n                                           item_y[i,2] + item_dimensions[i,2] <= item_y[j,2] \/\n                                           item_y[j,2] + item_dimensions[j,2] <= item_y[i,2] \/\n                                           item_z[i,3] + item_dimensions[i,3] <= item_z[j,3] \/\n                                           item_z[j,3] + item_dimensions[j,3] <= item_z[i,3]); solve satisfy; output [\n  "Item 1: (", show(item_x[1,1]), ",", show(item_y[1,2]), ",", show(item_z[1,3]), ") - (", show(item_x[1,1] + item_dimensions[1,1]), ",", show(item_y[1,2] + item_dimensions[1,2]), ",", show(item_z[1,3] + item_dimensions[1,3]), ")",\n  "Item 2: (", show(item_x[2,1]), ",", show(item_y[2,2]), ",", show(item_z[2,3]), ") - (", show(item_x[2,1] + item_dimensions[2,1]), ",", show(item_y[2,2] + item_dimensions[2,2]), ",", show(item_z[2,3] + item_dimensions[2,3]), ")",\n  "Item 3: (", show(item_x[3,1]), ",", show(item_y[3,2]), ",", show(item_z[3,3]), ") - (", show(item_x[3,1] + item_dimensions[3,1]), ",", show(item_y[3,2] + item_dimensions[3,2]), ",", show(item_z[3,3] + item_dimensions[3,3]), ")",\n  "Item 4: (", show(item_x[4,1]), ",", show(item_y[4,2]), ",", show(item_z[4,3]), ") - (", show(item_x[4,1] + item_dimensions[4,1]), ",", show(item_y[4,2] + item_dimensions[4,2]), ",", show(item_z[4,3] + item_dimensions[4,3]), ")",\n  "Item 5: (", show(item_x[5,1]), ",", show(item_y[5,2]), ",", show(item_z[5,3]), ") - (", show(item_x[5,1] + item_dimensions[5,1]), ",", show(item_y[5,2] + item_dimensions[5,2]), ",", show(item_z[5,3] + item_dimensions[5,3]), ")"\n];
